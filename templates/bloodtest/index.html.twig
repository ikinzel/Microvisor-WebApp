{% extends 'base.html.twig' %}

{% block title %}Blood Test - MicroVisor{% endblock %}

{% block body %}
    <h2 class="dash-welcome">Blood Test</h2>

    <div class="form-container form-container--wide" style="max-width: 860px;">

        {# ── Upload form ── #}
        <div class="food-panel" style="padding: 16px; margin-bottom: 16px;">
            <h3 style="margin: 0 0 10px;">Upload Blood Test PDF</h3>
            <p class="form-subtitle" style="text-align: left; margin-bottom: 12px;">
                Upload your blood test report as a PDF. Values for vitamins and minerals will be extracted automatically.
            </p>
            {% if error %}
                <p class="form-error">{{ error }}</p>
            {% endif %}
            <form method="POST" action="{{ path('app_bloodtest_upload') }}" enctype="multipart/form-data">
                <div class="form-row" style="grid-template-columns: 1fr auto; gap: 12px; align-items: end;">
                    <div class="form-group" style="margin: 0;">
                        <label for="bloodtest_pdf">PDF file</label>
                        <input type="file" id="bloodtest_pdf" name="bloodtest_pdf" accept="application/pdf,.pdf" required>
                    </div>
                    <button type="submit" class="form-btn" style="margin: 0;">Upload &amp; Extract</button>
                </div>
            </form>
        </div>

        {# ── Latest results ── #}
        {% if latestByNutrient is not empty %}
            <div class="food-panel" style="padding: 16px; margin-bottom: 16px;">
                <h3 style="margin: 0 0 10px;">Results
                    <span style="font-size: 0.8rem; font-weight: 400; color: #666;">— latest upload</span>
                </h3>
                <div class="form-row" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
                    {% for name, result in latestByNutrient %}
                        <div style="padding: 10px 12px; border: 1px solid rgba(221, 161, 94, 0.55); border-radius: 10px; background: #faf8f3;">
                            <div style="font-weight: 700; color: #283618; margin-bottom: 4px;">{{ name }}</div>
                            <div style="color: #333;">{{ result.value }} {{ result.unit }}</div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# ── Upload history ── #}
        {% if sessions is not empty %}
            <div class="food-panel" style="padding: 16px;">
                <h3 style="margin: 0 0 12px;">Upload History</h3>
                {% for dateKey, session in sessions %}
                    <details style="margin-bottom: 10px; border: 1px solid rgba(221, 161, 94, 0.4); border-radius: 10px; overflow: hidden;">
                        <summary style="padding: 10px 14px; background: #f5f0e8; cursor: pointer; font-weight: 600; color: #283618; list-style: none; display: flex; justify-content: space-between; align-items: center;">
                            <span>{{ dateKey|date('F j, Y — H:i') }}</span>
                            <span style="font-weight: 400; color: #666; font-size: 0.85rem;">{{ session.results|length }} nutrient{{ session.results|length != 1 ? 's' : '' }}</span>
                        </summary>
                        <div style="padding: 12px 14px; background: #faf8f3;">
                            <div class="form-row" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                                {% for result in session.results %}
                                    {% set prev = session.prevByNutrient[result.nutrientName] ?? null %}
                                    <div style="padding: 8px 10px; border: 1px solid rgba(221, 161, 94, 0.4); border-radius: 8px; background: #fff;">
                                        <div style="font-weight: 600; color: #283618; margin-bottom: 2px; font-size: 0.9rem;">{{ result.nutrientName }}</div>
                                        <div style="color: #333; font-size: 0.9rem;">{{ result.value }} {{ result.unit }}</div>
                                        {% if prev %}
                                            {% set diff = result.value - prev.value %}
                                            {% if diff > 0 %}
                                                <div style="font-size: 0.8rem; color: #4a7c59; margin-top: 3px;">↑ +{{ diff|number_format(1, '.', '') }} {{ result.unit }}</div>
                                            {% elseif diff < 0 %}
                                                <div style="font-size: 0.8rem; color: #b94a3a; margin-top: 3px;">↓ {{ diff|number_format(1, '.', '') }} {{ result.unit }}</div>
                                            {% else %}
                                                <div style="font-size: 0.8rem; color: #888; margin-top: 3px;">= no change</div>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </details>
                {% endfor %}
            </div>
        {% endif %}

    </div>
{% endblock %}
